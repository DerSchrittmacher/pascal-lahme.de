# Der Schrittmacher – pascal-lahme.de (Apache bei ALL-INKL)

Options -MultiViews -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Interne Ordner nicht ausliefern
RewriteRule ^\.(git|github)(/|$) - [R=404,L]

# /index.html und /index -> /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Aufrufe mit .html -> Adresse ohne Endung (301)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Schrägstrich am Ende entfernen (/kontakt/ -> /kontakt)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Adresse ohne Endung intern auf die .html-Datei abbilden
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_mime.c>
AddType font/woff2 .woff2
AddType image/svg+xml .svg
</IfModule>

# Schrift und Bilder lange zwischenspeichern, HTML immer frisch
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/jpeg "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType text/css "access plus 1 week"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>
